# Copy this file to .env, then enter your values.
# Do not share the .env file or commit it.
# UnificAlly (Kling 4.0 video)
UNIFICALLY_API_KEY=

# iCount payment provider
ICOUNT_CID=
ICOUNT_USER=
ICOUNT_PASS=
ICOUNT_PAGE_ID=

# Production configuration
# Must be the public https address, so UnificAlly can download uploaded product images
BASE_URL=http://127.0.0.1:8765
CLIPIC_HOST=127.0.0.1
PORT=8765
